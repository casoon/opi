---
import { readFile } from 'node:fs/promises';
import {
  AnchorGrid,
  Badge,
  Badges,
  Button,
  CodeBlock,
  Faq,
  Features,
  Hero,
  Install,
  Integrations,
  Quickstart,
  ReleaseHighlights,
  Spotlight,
  Tabs,
} from '@casoon/pages-theme/components';
import Base from '@casoon/pages-theme/layouts/Base.astro';
import { parseChangelog } from '@casoon/pages-theme/lib/changelog';
import config from 'virtual:casoon-pages/config';
import { url } from '@casoon/pages-theme/url';
// The README's recordings, imported rather than copied so there is one file each. The hero
// GIFs are recorded with vhs (keys pressed inside the interface): demo/tapes/hero.tape at about
// 55 columns for the hero column and at about 43 for phones, since the README's opi.gif shrinks
// to unreadable text there. The SVGs are castwright scenes from demo/casts/*.terminal.yaml with
// opi's real output (demo/record.sh).
import heroColumn from '../../../assets/opi-column.gif';
import heroPhone from '../../../assets/opi-phone.gif';
import directSvg from '../../../assets/direct.svg?url';
import healthSvg from '../../../assets/health.svg?url';
import pushSvg from '../../../assets/push.svg?url';
import securitySvg from '../../../assets/security.svg?url';
import updatesSvg from '../../../assets/updates.svg?url';
// The same scenes at 50 columns for phones, where the 92-column ones shrink below 6 px.
import healthNarrowSvg from '../../../assets/health-narrow.svg?url';
import pushNarrowSvg from '../../../assets/push-narrow.svg?url';
import securityNarrowSvg from '../../../assets/security-narrow.svg?url';
import updatesNarrowSvg from '../../../assets/updates-narrow.svg?url';

// Skip "Unreleased": it has no version to show as "New in v…" yet.
const latestRelease = config.changelog
  ? parseChangelog(await readFile(config.changelog, 'utf8')).find(
      (r) => r.version.toLowerCase() !== 'unreleased'
    )
  : undefined;

const usage = `opi                 # pick a script
opi dev             # run one directly
opi --check commit  # checks before a commit
opi --hooks         # checks before every push`;
---

<Base>
  <Hero
    title="Run a repository. Check it before it ships."
    lead="opi gives every project the same terminal interface: its scripts in one keyboard-driven list, and the checks its own tools can answer — before a commit, a push, a release or a deployment. npm, pnpm, Yarn, bun and Cargo, without configuring anything first."
  >
    <Install
      commands={[
        {
          label: 'install.sh',
          command: 'curl -fsSL https://raw.githubusercontent.com/casoon/opi/main/install.sh | sh',
        },
        { label: 'binstall', command: 'cargo binstall opi' },
        { label: 'cargo', command: 'cargo install opi' },
      ]}
    />
    <Badges>
      <Badge>MIT</Badge>
      <Badge>crates.io {config.version}</Badge>
      <Badge>macOS · Linux</Badge>
    </Badges>
    <picture slot="output">
      <source
        media="(max-width: 640px)"
        srcset={heroPhone.src}
        width={heroPhone.width}
        height={heroPhone.height}
      />
      <img
        class="hero-demo"
        src={heroColumn.src}
        width={heroColumn.width}
        height={heroColumn.height}
        alt="opi listing a monorepo's scripts, switching groups, searching across all of them and running one"
      />
    </picture>
  </Hero>

  <AnchorGrid
    items={[
      {
        label: 'Run',
        title: 'Every script in one list',
        body: 'Grouped, labelled from scripts-info, with the package manager detected. package.json and Cargo.toml side by side, workspace members included.',
        href: '#scripts',
        tone: 'accent',
      },
      {
        label: 'Check',
        title: 'The project’s own tools, run together',
        body: 'Health, security, updates and clean, one key each — and the same checks before a commit, a push, a release or a deployment.',
        href: '#checks',
        tone: 'brand',
      },
    ]}
  />

  <div id="scripts" class="anchor">
    <Spotlight
      eyebrow="Run"
      title="A better npm run, for every kind of project"
      lead="The start screen is the project's scripts. Enter runs the highlighted one, `/` filters across every group, and `opi dev` skips the list entirely."
      points={[
        'Grouped by prefix, labelled from `scripts-info`; past 15 entries or 5 groups the groups become tabs',
        'Workspace members appear under their own name: `opi blog/dev` runs the member’s script',
        '`cargo run`, `cargo build` and `cargo clippy` in the same list as the npm scripts',
        'The script replaces the opi process, so `Ctrl-C` and the exit code belong to it',
      ]}
      links={[
        { label: 'Scripts', href: url('docs/guides/scripts/') },
        { label: 'Rust projects', href: url('docs/guides/rust/') },
        { label: 'Configuration', href: url('docs/guides/configuration/') },
      ]}
    >
      <img
        class="spot"
        src={directSvg}
        width="796.8"
        height="476"
        loading="lazy"
        alt="opi dev starting the dev server directly, then opi api/db:migrate running a workspace member's script by path"
      />
    </Spotlight>
  </div>

  <Integrations
    heading="What opi reads, per ecosystem"
    items={[
      { icon: 'npm', name: 'npm', category: 'Scripts · health · security · updates' },
      { icon: 'pn', name: 'pnpm', category: 'Scripts · health · security · updates' },
      { icon: 'yn', name: 'Yarn', category: 'Scripts · health · security' },
      { icon: 'bun', name: 'bun', category: 'Scripts · health · security · updates' },
      { icon: 'rs', name: 'Cargo', category: 'Tasks · health · security · updates' },
    ]}
  />

  <section id="checks" class="block intro anchor" aria-labelledby="checks-heading">
    <p class="eyebrow">Check</p>
    <h2 id="checks-heading">Four areas, one key each</h2>
    <p class="lead">
      opi detects the tools a project already depends on, runs them concurrently and relays what
      they said. It reimplements no rules and keeps no score.
    </p>
  </section>

  <Features
    layout="grid"
    heading="What each area runs"
    items={[
      {
        icon: 'H',
        title: 'Health',
        body: 'Biome, ESLint, Prettier, tsc, astro check, Vitest, Jest, Knip, fallow and cargo fmt, clippy, doc and test — per workspace member, in the member.',
      },
      {
        icon: 'S',
        title: 'Security',
        body: 'Bundled secret scan, each package manager’s audit, cargo audit and osv-scanner, signatures, release age, install scripts, licenses, unpinned workflow actions.',
      },
      {
        icon: 'U',
        title: 'Updates',
        body: 'What is outdated, split into safe and major, with the offer to take it — applied by the package manager, not by opi.',
      },
      {
        icon: 'C',
        title: 'Clean',
        body: 'Build output such as dist, .astro, coverage and target/, each with its size; node_modules only if you pick everything. Nothing goes without your choice.',
      },
    ]}
  />

  <section class="block" aria-label="Recorded output">
    <Tabs
      label="opi areas"
      tabs={[
        { id: 'health', label: 'Health' },
        { id: 'security', label: 'Security' },
        { id: 'updates', label: 'Updates' },
      ]}
    >
      <div slot="health">
        <picture>
          <source
            media="(max-width: 640px)"
            srcset={healthNarrowSvg}
            width="444"
            height="476"
          />
          <img
            class="scene"
            src={healthSvg}
            width="796.8"
            height="404"
            loading="lazy"
            alt="opi --health running six checks in a project with package.json and Cargo.toml: Docs, Secrets, Lockfile, Lint and Tests pass, Format (rust) fails and rustfmt's diff of src/report.rs is shown under it, ending with '1 of 6 checks failed.'"
          />
        </picture>
      </div>
      <div slot="security">
        <picture>
          <source
            media="(max-width: 640px)"
            srcset={securityNarrowSvg}
            width="444"
            height="512"
          />
          <img
            class="scene"
            src={securitySvg}
            width="796.8"
            height="368"
            loading="lazy"
            alt="opi --security: no secrets found by the bundled nosecrets scanner, one high vulnerability in lodash, every installed package's signature verified, a note that no minimum release age is set, no dependencies with install scripts, and the license overview"
          />
        </picture>
      </div>
      <div slot="updates">
        <picture>
          <source
            media="(max-width: 640px)"
            srcset={updatesNarrowSvg}
            width="444"
            height="314"
          />
          <img
            class="scene"
            src={updatesSvg}
            width="796.8"
            height="332"
            loading="lazy"
            alt="opi --updates listing lodash 4.17.20 → 4.18.1 as a minor update that is safe to take, with the Rust dependencies current"
          />
        </picture>
      </div>
    </Tabs>
    <p class="note">
      Recorded with opi {config.version} in a demo project with <code>package.json</code> and{' '}
      <code>Cargo.toml</code>, an unformatted Rust file and an old lodash.
    </p>
    <div class="links">
      <Button href={url('docs/guides/health/')} variant="secondary">Health</Button>
      <Button href={url('docs/guides/security/')} variant="secondary">Security</Button>
      <Button href={url('docs/guides/updates/')} variant="secondary">Updates</Button>
      <Button href={url('docs/guides/clean/')} variant="secondary">Clean</Button>
    </div>
  </section>

  <section class="block" aria-labelledby="flow-heading">
    <p class="eyebrow">Check</p>
    <h2 id="flow-heading">Before a commit, a push, a release, a deployment</h2>
    <div class="text">
      <p>
        <code>opi --check commit</code> runs the project checks except tests and dead-code
        analysis, and looks at what is staged: secrets in the index, whitespace errors, conflict
        markers and new files over 500 KiB. It writes and stages nothing.
      </p>
      <p>
        <code>--check push</code>, <code>--check release</code> and <code>--check deploy</code>{' '}
        add the tests and the build on a clean tree — push also checks it is not behind upstream,
        release that the version is not tagged yet. The deploy check never runs your deploy
        script.
      </p>
      <p>
        <code>opi --checks push</code> picks which checks a workflow runs, saved in{' '}
        <code>.opi/checks.json</code> to share in Git. <code>opi --hooks</code> installs the push
        check as git's pre-push hook, so a repository without CI cannot push a red state by
        accident.
      </p>
    </div>
    <picture>
      <source media="(max-width: 640px)" srcset={pushNarrowSvg} width="444" height="692" />
      <img
        class="scene"
        src={pushSvg}
        width="796.8"
        height="548"
        loading="lazy"
        alt="opi --hooks installing the pre-push hook, then git push running opi --check push: working tree clean, not behind upstream, the checks and both builds, with Format (rust) failing, so the push is refused"
      />
    </picture>
    <div class="links">
      <Button href={url('docs/guides/workflows/')} variant="secondary">Workflows</Button>
      <Button href={url('docs/guides/integrations/')} variant="secondary">Hooks and CI</Button>
      <Button href={url('showcase/')} variant="secondary">More output in the showcase</Button>
    </div>
  </section>

  {latestRelease && <ReleaseHighlights release={latestRelease} />}

  <Quickstart
    lead="Install, change into a project, type opi. Grouping and confirmations can be refined in package.json — see Configuration in the documentation."
    steps={[
      'Install the release binary with the install script or <code>cargo binstall opi</code>, or build it with <code>cargo install opi</code>.',
      'Change into any directory of a project with a <code>package.json</code> or <code>Cargo.toml</code>.',
      'Run <code>opi</code> and pick a script — or name it: <code>opi dev</code>.',
    ]}
  >
    <CodeBlock code={usage} lang="sh" label="Usage" />
  </Quickstart>

  <Faq
    items={[
      {
        q: 'How do I know a downloaded binary is the one GitHub built?',
        a: 'Every release archive carries a signed build provenance attestation, and the release has a CycloneDX SBOM attested against each archive. gh attestation verify checks both; the installation page has the commands.',
      },
      {
        q: 'Can I check a downloaded binary for known vulnerabilities?',
        a: 'Yes. The release binaries are built with cargo auditable, which embeds the dependency list, so cargo audit bin opi works on the file itself.',
      },
      {
        q: 'Does opi write anything into my project?',
        a: 'Only what you ask for: the hook from opi --hooks, workflow selections from opi --checks in .opi/checks.json, and SBOMs from opi --sbom in .opi/sbom/, which stays ignored. No manifest, lockfile or script is rewritten.',
      },
    ]}
  />
</Base>

<style>
  .hero-demo {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 10px;
  }
  .block {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 24px 96px;
  }
  h2 {
    margin: 0 0 14px;
    color: var(--heading);
    font-size: 30px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .anchor {
    scroll-margin-top: 80px;
  }
  /* Links inside changelog entries need more than colour to stand out from the text. */
  :global(.release-highlights li a) {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .intro {
    padding-bottom: 32px;
  }
  .eyebrow {
    margin: 0 0 16px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .text code {
    white-space: nowrap;
  }
  .spot {
    display: block;
    width: 100%;
    height: auto;
  }
  .note {
    max-width: 72ch;
    margin: 12px 0 0;
    font-size: 14px;
  }
  .lead {
    max-width: 72ch;
    margin: 0 0 20px;
    font-size: 15.5px;
  }
  .text {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: 0 48px;
  }
  .text p {
    margin: 0 0 16px;
    font-size: 15.5px;
  }
  /* Never scale a terminal scene beyond a readable size. */
  .scene {
    display: block;
    width: 100%;
    max-width: 800px;
    height: auto;
    margin: 16px auto 0;
  }
  /* On a phone the narrow scene takes part of the tab panel's padding, for a larger font. */
  @media (max-width: 640px) {
    .scene {
      width: calc(100% + 20px);
      max-width: none;
      margin-inline: -10px;
    }
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 20px;
  }
</style>
